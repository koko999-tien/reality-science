+def audit(event,args):
+    if event=='socket.connect':
+        address=args[1]
+        with (E/(run+'-worker-connections.jsonl')).open('a') as stream:
+            stream.write(json.dumps({'pid':os.getpid(),'address':address})+'\n')
+
+
+sys.addaudithook(audit)
