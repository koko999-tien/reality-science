+        'message':'Synthetic protocol rejection fixture','dimensions_verified':False,
+        'layer_findings':{str(i):{'layer':i,'name':str(i),'state':'PASS',
+            'diagnostic_code':'PROTOCOL_FIXTURE','message':'Synthetic fixture'} for i in range(1,7)}}}
