# =============================================================================
# REALITY SCIENCE — Backend API Environment Configuration (Zone 2)
# Zero secrets committed — provide development defaults for docker-compose
# =============================================================================

PROJECT_NAME="REALITY SCIENCE API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Connection (Zone 2 Internal Network)
DATABASE_URL=postgresql+asyncpg://rs_app_user:app_secure_password@postgres:5432/reality_science

# Redis Connection (Dual-homed Zone 2 / Zone 3)
REDIS_URL=redis://:redis_secret_pw@redis:6379/0

# Security & Cryptography
JWT_SECRET_KEY=dev_jwt_secret_change_in_production_min_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
