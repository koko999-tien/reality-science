# =============================================================================
# REALITY SCIENCE — Canonical Monorepo Environment Configuration Template
# ZERO PRODUCTION SECRETS COMMITTED — DEVELOPMENT DEFAULTS ONLY
# =============================================================================

PROJECT_NAME="REALITY SCIENCE"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Zone 1: Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Zone 2: FastAPI Backend Core
DATABASE_URL=postgresql+asyncpg://rs_app_user:app_secure_password@postgres:5432/reality_science
REDIS_URL=redis://:redis_secret_pw@redis:6379/0
JWT_SECRET_KEY=dev_jwt_secret_change_in_production_min_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Zone 3: Celery Compute Worker (Strictly Zero Postgres Credentials)
CELERY_BROKER_URL=redis://:redis_secret_pw@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_secret_pw@redis:6379/1
INTERACTIVE_TIMEOUT_SECONDS=10
BATCH_TIMEOUT_SECONDS=120
