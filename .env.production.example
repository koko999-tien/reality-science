# =============================================================================
# REALITY SCIENCE — Production Environment Configuration Template
# PRODUCTION HARDENING TEMPLATE — DO NOT COMMIT REAL PRODUCTION SECRETS
# Generate strong 256-bit entropy keys using:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

PROJECT_NAME="REALITY SCIENCE"
ENVIRONMENT=production
LOG_LEVEL=INFO

# Zone 1: Next.js Frontend
NEXT_PUBLIC_API_URL=https://reality-science.org/api/v1
NEXT_PUBLIC_APP_ENV=production

# Zone 2: PostgreSQL (Internal data_net only)
POSTGRES_DB=reality_science
POSTGRES_USER=rs_prod_user
# MUST be set via orchestrator/secret manager in production (min 32 chars)
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_MIN_32_HEX
DATABASE_URL=postgresql+asyncpg://rs_prod_user:${POSTGRES_PASSWORD}@postgres:5432/reality_science

# Dual-homed: Redis Message Broker & Result Conduit (Internal data_net & compute_net)
REDIS_PASSWORD=GENERATE_STRONG_RANDOM_REDIS_PASSWORD_MIN_32_HEX
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# Object Storage: MinIO / S3 (Internal data_net only)
MINIO_ROOT_USER=rs_prod_minio_admin
MINIO_ROOT_PASSWORD=GENERATE_STRONG_RANDOM_MINIO_PASSWORD_MIN_32_HEX

# Security & Cryptography (Zone 2)
# Mandatory 256-bit key for JWT token signing
JWT_SECRET_KEY=GENERATE_STRONG_RANDOM_JWT_SECRET_KEY_MIN_32_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["https://reality-science.org"]

# Zone 3: Celery Compute Worker Timeouts
# STRICT ZERO DATABASE INVARIANT: Compute workers NEVER receive DATABASE_URL or POSTGRES credentials!
INTERACTIVE_TIMEOUT_SECONDS=10
BATCH_TIMEOUT_SECONDS=120
